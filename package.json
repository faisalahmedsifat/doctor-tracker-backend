{
  "name": "doctor-tracker-api",
  "version": "0.1.0",
  "description": "Doctor Tracker REST API built with Express 5 and TypeScript",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run test/*.test.ts",
    "test:integration": "vitest run test/integration --reporter=verbose",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
