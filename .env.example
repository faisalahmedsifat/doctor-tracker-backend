NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6381
REDIS_LOCK_TTL_MS=30000
REDIS_LOCK_WAIT_MS=3000
FRONTEND_ORIGIN=http://localhost:3000
# Set to a shared parent domain when frontend and API use subdomains, e.g. .example.com
# COOKIE_DOMAIN=.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
